<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Retrocrunch third-party licences</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; background: #16161c; color: #ddd; }
a { color: #8cf; }
pre { white-space: pre-wrap; background: #222230; padding: 1em; }
.license { border-top: 1px solid #444; margin-top: 2em; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Retrocrunch is built with the following open-source software. Each licence below applies
to the crates listed with it.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<div class="license">
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul>
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</div>
{{/each}}
</body>
</html>
